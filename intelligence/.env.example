# Copy these values into the repository root's .env - that is the file llm.py reads - and add your own.
# Never commit .env or a real API key. Placeholder names only; the key lines stay empty here.

# The reader this pipeline asks about a narrative record: Gemini's interactions endpoint. One Google
# account serves both models below, so one credential covers the whole configuration and the chain
# file names its variable.
INTELLIGENCE_LLM_PROVIDER=gemini
INTELLIGENCE_LLM_MODEL=gemini-3.8-flash
# The endpoint needs no URL: provider gemini is the alias for https://generativelanguage.googleapis.com.
# Set INTELLIGENCE_LLM_BASE_URL only for an endpoint that stands in for Google's.
INTELLIGENCE_LLM_BASE_URL=
# Either name works and the pipeline's own wins if both are set. The key travels as a header, never in
# the URL, and is never written into a log, a checkpoint or a report.
GEMINI_API_KEY=
INTELLIGENCE_LLM_API_KEY=

INTELLIGENCE_LLM_TIMEOUT_SECONDS=120
INTELLIGENCE_LLM_MAX_RETRIES=2
# The most time ONE request may spend waiting out a busy window (429). A wait the provider states
# longer than this stops the sends for that record instead of being half-waited.
INTELLIGENCE_LLM_MAX_WAIT_SECONDS=60
INTELLIGENCE_LLM_TEMPERATURE=0
# One budget for the thinking and the answer together: this endpoint counts both against
# max_output_tokens, so an answer cut off mid-JSON is reported with the tokens each part took.
INTELLIGENCE_LLM_MAX_TOKENS=8192
# low, medium or high map to the endpoint's own thinking levels. none is the least thinking it
# offers (it has no value for none at all); default sends no thinking level and leaves the model's own
# in force.
INTELLIGENCE_LLM_REASONING_EFFORT=low

# The ordered model chain for narrative records, asked in this order until one answers. Unset, the single
# reader above is the whole configuration. --llm-chain FILE names the same file for one run without
# touching this. Paths open from the directory the run is started in, so give it as
# intelligence/chain.gemini.json from the repository root, or absolute.
INTELLIGENCE_LLM_CHAIN_FILE=intelligence/chain.gemini.json
# That file holds two Gemini candidates: gemini-3.8-flash first, gemini-3.5-flash-lite second, each with
# provider gemini, base_url https://generativelanguage.googleapis.com and api_key_env GEMINI_API_KEY.
# The credential therefore comes from GEMINI_API_KEY, never from the file, and never from
# INTELLIGENCE_LLM_API_KEY, which stays empty while the chain is named. timeout_seconds, max_retries,
# max_wait_seconds, temperature, max_tokens and reasoning_effort are inherited from the values above, so
# one budget governs the whole chain.
#
# Both models share one account, so they are one scope and a refusal that account makes - a spent
# allowance, a busy window, a refused credential, an endpoint that is down - closes both of them for the
# run and the record is left for a later one rather than costing a second send. Only a refusal about the
# model itself (an id the endpoint will not serve) or about an unreadable answer gives the other its turn.
#
# provider openai_compatible (any OpenAI-compatible chat endpoint, including OpenRouter) and provider
# groq stay implemented and stay configurable: INTELLIGENCE_LLM_PROVIDER plus the model id that endpoint
# serves, and a chain entry naming them, still work exactly as they did. intelligence/chain.openrouter.json
# is that configuration for one OpenRouter account.

INTELLIGENCE_API_BASE_URL=http://127.0.0.1:8000
