# Copy these values into the repository root's .env - that is the file llm.py reads - and add your own.
# Never commit .env or a real API key. Placeholder names only; the key lines stay empty here.

# The reader this pipeline asks about a narrative record: Groq's hosted gpt-oss, through the official
# groq SDK, with the answer schema sent as strict structured output so the endpoint itself constrains
# the shape. One vendor, one model, one credential - the chain file below holds this same candidate.
INTELLIGENCE_LLM_PROVIDER=groq
INTELLIGENCE_LLM_MODEL=openai/gpt-oss-120b
# The endpoint needs no URL: provider groq is the alias for https://api.groq.com, and the SDK is handed
# that origin because it appends its own path. Set INTELLIGENCE_LLM_BASE_URL only for an endpoint that
# stands in for Groq's.
INTELLIGENCE_LLM_BASE_URL=
# Either name works and the pipeline's own wins when both are set, so a Gemini or OpenRouter key left in
# INTELLIGENCE_LLM_API_KEY would be sent to Groq as this run's credential. Keep that line empty while
# the provider is groq. The key travels as a header, never in a URL, and is never written into a log, a
# checkpoint or a report.
GROQ_API_KEY=
INTELLIGENCE_LLM_API_KEY=

INTELLIGENCE_LLM_TIMEOUT_SECONDS=120
INTELLIGENCE_LLM_MAX_RETRIES=2
# The most time ONE request may spend waiting out a busy window (429). A wait the provider states
# longer than this stops the sends for that record instead of being half-waited.
INTELLIGENCE_LLM_MAX_WAIT_SECONDS=60
INTELLIGENCE_LLM_TEMPERATURE=0
# Groq counts the thinking and the answer against one completion budget, so this is the room the whole
# reply has: an answer cut off mid-JSON is reported as a budget failure with the schema it was held to,
# never as a record that refused to be read.
INTELLIGENCE_LLM_MAX_TOKENS=8192
# low, medium and high are the efforts Groq honours for gpt-oss, and low leaves the most of the budget
# above for the answer. default sends nothing and leaves the model's own effort in force. none is read
# by this configuration and passed through as it is named, which Groq answers as an invalid value, so
# use it only against an endpoint that takes it.
INTELLIGENCE_LLM_REASONING_EFFORT=low

# The ordered model chain for narrative records, asked in this order until one answers. Unset, the single
# reader above is the whole configuration. --llm-chain FILE names the same file for one run without
# touching this. Paths open from the directory the run is started in, so give it as
# intelligence/chain.groq.json from the repository root, or absolute.
INTELLIGENCE_LLM_CHAIN_FILE=intelligence/chain.groq.json
# That file holds ONE candidate: provider groq, model openai/gpt-oss-120b, base_url
# https://api.groq.com, api_key_env GROQ_API_KEY. It is one entry on purpose. A fallback is a decision,
# not a default: nothing here walks from Groq to Gemini when Groq refuses, so a spent allowance or a
# refused credential ends the run's semantic reads and says so, and a record is left unread rather than
# read by a model nobody chose. Add a second candidate by naming another model on the same vendor; a
# different vendor needs its own base_url and its own api_key_env, and its credential comes from that
# variable, never from the file. timeout_seconds, max_retries, max_wait_seconds, temperature, max_tokens
# and reasoning_effort are inherited from the values above, so one budget governs the whole chain.
#
# Both candidates of a same-account chain share one scope, so a refusal that vendor makes - a spent
# allowance, a busy window, a refused credential, an endpoint that is down - closes them together for
# the run. Only a refusal about the model itself (an id the endpoint will not serve) or about an
# unreadable answer gives the next candidate its turn, and the log names which one answered.
#
# provider gemini and provider openai_compatible (any OpenAI-compatible chat endpoint, including
# OpenRouter) stay implemented and stay configurable: INTELLIGENCE_LLM_PROVIDER plus the model id that
# endpoint serves, and a chain entry naming them, still work exactly as they did.
# intelligence/chain.gemini.json and intelligence/chain.openrouter.json are those configurations, kept as
# explicit alternatives - point INTELLIGENCE_LLM_CHAIN_FILE at one of them, and put that vendor's key in
# INTELLIGENCE_LLM_API_KEY or the variable its entries name, to go back.

INTELLIGENCE_API_BASE_URL=http://127.0.0.1:8000

# --document only. Empty means: look on PATH, then (Tesseract) its default Windows install folder.
INTELLIGENCE_TESSERACT_CMD=
INTELLIGENCE_PDFTOTEXT_CMD=
