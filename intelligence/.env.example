# Copy this file to intelligence/.env and fill in the line marked REQUIRED. llm.py reads intelligence/.env
# specifically, not the repository root's .env. Never commit it, and never put a real key in this example.
#
# Two loading rules worth knowing before you edit anything:
# - python-dotenv reads the file with override=False, so a variable you export in the shell wins over it.
# - a process reads it once when it starts. After you replace a key here, restart the pipeline and restart
#   the chat service, or the running process keeps answering with the credential it already holds.

# ------------------------------------------------------------------ the credential
# REQUIRED. The chain this build ships with (intelligence/chain.groq.json) names GROQ_API_KEY as its
# api_key_env, so this is the only key the chat and the semantic reads send. It travels in a request
# header, never in a URL, and is never written into a log, a checkpoint, a report or a browser response.
GROQ_API_KEY=

# ------------------------------------------------------------------ the model chain
# The ordered candidates a narrative read is asked of, tried in line until one answers. Relative paths
# open from the directory the run starts in, so start every run from the repository root or write this
# absolute. Unset, the single reader named by INTELLIGENCE_LLM_PROVIDER and INTELLIGENCE_LLM_MODEL below
# is the whole configuration. --llm-chain FILE picks another file for one run without touching this.
INTELLIGENCE_LLM_CHAIN_FILE=intelligence/chain.groq.json

# That file holds ONE candidate on purpose: provider groq, model openai/gpt-oss-120b, base_url
# https://api.groq.com, api_key_env GROQ_API_KEY. A fallback is a decision, not a default: nothing here
# walks from Groq to Gemini when Groq refuses, so a spent allowance or a refused credential ends the run's
# semantic reads and says so, and a record is left unread rather than read by a model nobody chose.
# Add a candidate by naming another model on the same vendor; a different vendor needs its own base_url
# and its own api_key_env, and its credential comes from that variable, never from this file. Candidates
# of one vendor share a scope, so a refusal that vendor makes - a spent allowance, a busy window, a
# refused credential, an endpoint that is down - closes them together for that run. Only a refusal about
# the model itself, or about an unreadable answer, gives the next candidate its turn.
# intelligence/chain.gemini.json and intelligence/chain.openrouter.json are the alternatives: point the
# line above at one of them and put that vendor's key in the variable its entries name to go back.

# ------------------------------------------------------------------ the request budget
# Each number below is inherited by every candidate that does not state its own, so one budget governs
# the whole chain.
INTELLIGENCE_LLM_TIMEOUT_SECONDS=120
INTELLIGENCE_LLM_MAX_RETRIES=2
# The most time ONE request may spend waiting out a busy window (429). A wait the provider states longer
# than this stops the sends for that record instead of being half-waited.
INTELLIGENCE_LLM_MAX_WAIT_SECONDS=60
INTELLIGENCE_LLM_TEMPERATURE=0
# Groq counts the thinking and the answer against one completion budget, so this is the room the whole
# reply has. An answer cut off mid-JSON is reported as a budget failure with the schema it was held to,
# never as a record that refused to be read.
INTELLIGENCE_LLM_MAX_TOKENS=8192
# low, medium and high are the efforts Groq honours for gpt-oss, and low leaves the most of the budget
# above for the answer. default sends nothing and leaves the model's own effort in force. none is passed
# through as it is named, which Groq answers as an invalid value, so use it only against an endpoint that
# takes it.
INTELLIGENCE_LLM_REASONING_EFFORT=low

# ------------------------------------------------------------------ the single reader, used when no chain file is set
# With the chain file above these are overridden: provider, model and base_url come from the entry. Keep
# them naming the same Groq model so a run started without INTELLIGENCE_LLM_CHAIN_FILE still works.
INTELLIGENCE_LLM_PROVIDER=groq
INTELLIGENCE_LLM_MODEL=openai/gpt-oss-120b
# provider groq is the alias for https://api.groq.com, and the SDK is handed that origin because it
# appends its own path. Set this only for an endpoint that stands in for Groq's.
INTELLIGENCE_LLM_BASE_URL=
# A chain entry with no api_key_env reads this name. It also wins over GROQ_API_KEY for the single reader,
# so a Gemini or OpenRouter key left here would be sent to Groq as this run's credential. Keep this line
# empty while the provider is groq.
INTELLIGENCE_LLM_API_KEY=

# ------------------------------------------------------------------ the dashboard records are posted to
# Read by the pipeline's --post-incidents (intelligence/pipeline.py). The chat service does not read it;
# it takes the base URL in the section below. Needed only when something is posted.
INTELLIGENCE_API_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------ the chat service only
# Read by python -m intelligence.chat_service. Every line is optional and the flag named beside it wins.
# The service needs no credential of its own: it takes the configuration above, keeps it server-side, and
# never passes it to the browser. A question the records cannot answer is answered as marked general
# background only while that configuration has a working model; with none, the question is refused.
# --host, default 127.0.0.1
INTELLIGENCE_CHAT_HOST=
# --port, default 8010
INTELLIGENCE_CHAT_PORT=
# --origins: comma-separated browser origins allowed to call the service, e.g.
# http://localhost:5173,http://127.0.0.1:5173. Empty, the four defaults above are used; set it to the
# origin the dashboard is actually on whenever Vite moved past 5174.
INTELLIGENCE_CHAT_ORIGINS=
# --api-url: the backend base whose /incidents list joins the corpus a question is answered from, default
# http://127.0.0.1:8000. An empty value HERE falls back to that default, so to answer only from the
# readings stored with --state-dir, pass --api-url with no value instead of leaving this line blank.
INTELLIGENCE_CHAT_API_URL=

# The dashboard's own settings stay out of this file: frontend/.env holds VITE_API_BASE_URL and
# VITE_CHAT_BASE_URL, and both are values the browser can see.
